# AetherFace Environment Variables Template
# Copy this file to .env and adjust variables as needed

# Admin Key: Required to authenticate high-privilege operations:
# - Deleting individual attendance log entries
# - Clearing entire attendance history
# - Deleting faculty members from faculty.db
admin_key="admin123"

# Port for local Express + Vite server (default: 3000)
PORT=3000

# Application Host URL
APP_URL="http://localhost:3000"

# -------------------------------------------------------------
# Optional Firebase Integration (Cloud Attendance Logs Sync)
# To connect Firebase Firestore to persist/sync attendance logs:
# -------------------------------------------------------------
# Server-side Firebase Admin SDK (for Node.js Express backend):
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Client-side Firebase SDK (for Vite / React frontend):
# VITE_FIREBASE_API_KEY="AIzaSy..."
# VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="your-project-id"
# VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
# VITE_FIREBASE_MESSAGING_SENDER_ID="1234567890"
# VITE_FIREBASE_APP_ID="1:1234567890:web:abcdef"
